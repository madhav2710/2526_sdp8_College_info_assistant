### Backend environment example for College Platform API
# Copy to `.env` or `_env` and fill in real secrets before running

# Supabase (database + auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# alternative name supported by code: SERVICE_ROLE_KEY
SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini / Generative AI (optional but recommended for RAG)
GEMINI_API_KEY=your-google-gemini-api-key

# JWT / Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# RAG / AI settings (defaults shown in code)
RAG_EMBEDDING_MODEL=models/embedding-001
RAG_GENERATION_MODEL=gemini-1.5-flash
RAG_MAX_RETRIES=3
RAG_RETRY_DELAY=1.0
RAG_RETRY_BACKOFF_FACTOR=2.0
RAG_MAX_RETRY_DELAY=60.0
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=300
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CHUNKS_PER_QUERY=5

# File upload settings
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.txt

# Rate limiting
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# Application
APP_NAME=College Platform API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Notes:
# - Place this file at the project `backend` root as `.env` (or keep as `_env`) so the
#   backend will load it automatically. Do NOT commit real secrets to version control.