# Unified single-project Supabase configuration
# Required
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional alias used by some code paths (keep equal to SUPABASE_SERVICE_ROLE_KEY)
SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# AI (optional but needed for full RAG answers)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# JWT / Security (required; use 32+ random chars)
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# RAG tuning (optional defaults)
RAG_EMBEDDING_MODEL=models/embedding-001
RAG_GENERATION_MODEL=gemini-1.5-flash
RAG_MAX_RETRIES=3
RAG_RETRY_DELAY=1.0
RAG_RETRY_BACKOFF_FACTOR=2.0
RAG_MAX_RETRY_DELAY=60.0
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=300
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CHUNKS_PER_QUERY=5

# Upload settings
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.txt

# Rate limiting
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# App settings
APP_NAME=College Platform API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Migration runner connection (optional, only for backend/run_migration.py)
# Prefer DATABASE_URL:
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Or component vars:
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=YOUR_DB_PASSWORD

# Keep single-project mode:
# Do not set RAG_SUPABASE_*, SUPABASE_RAG_*, or VECTOR_SUPABASE_* to different values.
